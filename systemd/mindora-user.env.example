# user_server 专有环境（LLM key 只给需要它的服务）。
# 部署：sudo install -m 0600 systemd/mindora-user.env.example /etc/mindora/mindora-user.env

# 火山方舟（url/model 在 config.py，key 走环境变量，见 llm/router.py）
ARK_API_KEY=
# Kimi（可选；不配则 LLM 路由全部走 volc_ark）
KIMI_API_KEY=

# auth_server 地址（/ops/* 接口校验运营角色用）
AUTH_SERVER_URL=http://127.0.0.1:9103

JWT_PUBLIC_KEY_PATH=/etc/mindora/jwt_public.pem
JWT_SECRET_KEY=
RUN_DIR=/root/server/mindora_user
