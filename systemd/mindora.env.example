# Mindora 共享环境变量（systemd EnvironmentFile 格式）。
# 部署：sudo install -m 0600 systemd/mindora.env.example /etc/mindora/mindora.env
#       然后编辑 /etc/mindora/mindora.env 填入真实密钥。
# 注意：EnvironmentFile 不支持行内注释和引号，KEY=VALUE 一行一个。

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mindora
MYSQL_PASSWORD=Mindora@2026
MYSQL_DB=mindora_db
MYSQL_CHARSET=utf8mb4

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT（RS256 密钥文件；私钥仅云端 0600）
JWT_SECRET_KEY=__CHANGE_ME_RANDOM__
JWT_PRIVATE_KEY_PATH=/etc/mindora/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/etc/mindora/jwt_public.pem
JWT_EXPIRE_SECONDS=604800
VERIFY_CODE_EXPIRE_SECONDS=300

RUN_DIR=/root/server/mindora_user
